# The build as an SDK, for programs that are not in the tree yet
# (Syllable-Build-System's ./sb compile, through cmake/sdk).
#
# Included last: it walks every directory for the libraries the tree builds
# (shared libraries: libsyllable, libmedia...; interface targets:
# syllable::z, syllable::curl...) and writes ${CMAKE_BINARY_DIR}/sdk/targets.cmake,
# which defines each one again as an imported target pointing at this build.

function(_syllable_sdk_collect dir out)
  get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
  get_property(subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
  set(found ${${out}})
  foreach(t ${targets})
    get_target_property(type ${t} TYPE)
    if(type STREQUAL "SHARED_LIBRARY" OR type STREQUAL "INTERFACE_LIBRARY")
      list(APPEND found ${t})
    endif()
  endforeach()
  set(${out} ${found} PARENT_SCOPE)
  foreach(sub ${subdirs})
    _syllable_sdk_collect(${sub} found)
  endforeach()
  set(${out} ${found} PARENT_SCOPE)
endfunction()

set(_sdk_targets)
_syllable_sdk_collect(${PROJECT_SOURCE_DIR} _sdk_targets)

set(_sdk "# Generated by cmake/SyllableSDK.cmake: this build's libraries\n")
foreach(t ${_sdk_targets})
  get_target_property(type ${t} TYPE)
  get_target_property(dir ${t} SOURCE_DIR)
  # as declared (file(GENERATE) evaluates what generator expressions they hold)
  get_target_property(incs ${t} INTERFACE_INCLUDE_DIRECTORIES)
  get_target_property(libs ${t} INTERFACE_LINK_LIBRARIES)
  if(NOT incs)
    set(incs "")
  endif()
  if(NOT libs)
    set(libs "")
  endif()
  set(iface "INTERFACE_INCLUDE_DIRECTORIES \"${incs}\" INTERFACE_LINK_LIBRARIES \"${libs}\"")
  # A library of the program being compiled (sb compile of a folder that is
  # also in the tree) is left to the program's own CMakeLists.txt
  # (SYLLABLE_SDK_OWN: its folder, set by cmake/sdk)
  string(APPEND _sdk "string(FIND \"${dir}/\" \"\${SYLLABLE_SDK_OWN}/\" _own)
if(NOT SYLLABLE_SDK_OWN OR NOT _own EQUAL 0)\n")
  if(type STREQUAL "SHARED_LIBRARY")
    string(APPEND _sdk "add_library(${t} SHARED IMPORTED GLOBAL)
set_target_properties(${t} PROPERTIES IMPORTED_LOCATION \"$<TARGET_FILE:${t}>\"
  ${iface})\n")
  else()
    string(APPEND _sdk "add_library(${t} INTERFACE IMPORTED GLOBAL)
set_target_properties(${t} PROPERTIES ${iface})\n")
    if(t MATCHES "^syllable_(.*)$")
      string(APPEND _sdk "add_library(syllable::${CMAKE_MATCH_1} ALIAS ${t})\n")
    endif()
  endif()
  string(APPEND _sdk "endif()\n")
endforeach()
file(GENERATE OUTPUT ${CMAKE_BINARY_DIR}/sdk/targets.cmake CONTENT "${_sdk}")

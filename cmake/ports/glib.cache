# GLib 2.14.4's configure checks that only run on the target, answered for i586
# Syllable (glibc 2.7); the list is GLib's own cross-compiling notes'
glib_cv_long_long_format=ll
glib_cv_stack_grows=no
glib_cv_working_bcopy=no
glib_cv_sane_realloc=yes
glib_cv_have_strlcpy=no
glib_cv_va_val_copy=yes
glib_cv_va_copy=yes
glib_cv___va_copy=yes
glib_cv_has__inline=yes
glib_cv_has__inline__=yes
glib_cv_hasinline=yes
glib_cv_rtldglobal_broken=no
glib_cv_uscore=no
glib_cv_compliant_posix_memalign=1
glib_cv_langinfo_codeset=yes
glib_cv_use_pid_surrogate=yes
ac_cv_func_posix_getpwuid_r=yes
ac_cv_func_nonposix_getpwuid_r=no
ac_cv_func_posix_getgrgid_r=yes
ac_cv_func_printf_unix98=yes
ac_cv_func_vsnprintf_c99=yes
# Its cross configure wants a build-host glib-genmarshal (the image's, found in
# PATH), which it never runs: --disable-rebuilds keeps the marshallers the
# tarball ships (a newer genmarshal's output doesn't fit GLib 2.14)

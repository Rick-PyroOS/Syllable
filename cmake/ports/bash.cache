# Autoconf answers for cross-compiling bash for Syllable (CONFIG_SITE).
# configure can't run test programs when cross compiling and otherwise falls
# back to "missing" for job control, sigsetjmp, named pipes...  These are the
# answers glibc 2.7 gives; ASSUMED for Syllable, to be confirmed on a booted
# system (M1 boot test).
bash_cv_job_control_missing=present
bash_cv_func_sigsetjmp=present
bash_cv_sys_named_pipes=present
bash_cv_must_reinstall_sighandlers=no
bash_cv_func_ctype_nonascii=no
bash_cv_dup2_broken=no
bash_cv_sys_siglist=yes
bash_cv_under_sys_siglist=yes
bash_cv_getenv_redef=yes
bash_cv_opendir_not_robust=no
bash_cv_pgrp_pipe=no
bash_cv_printf_a_format=yes
bash_cv_unusable_rtsigs=no
bash_cv_func_strcoll_broken=no
bash_cv_ulimit_maxfds=yes
bash_cv_wcontinued_broken=no
bash_cv_getcwd_malloc=yes

# Paths for software compilation
#
# Two compilers, each with its binutils: /usr/gcc/4.1.2 (the system's) and
# /usr/gcc/9.5.0.  use-gcc picks one for this shell (the default: 4.1.2):
#
#   use-gcc 9.5.0      its bin first in PATH, its lib in LIBRARY_PATH (and in
#                      DLL_PATH, for its newer libstdc++), and C_INCLUDE_PATH
#                      without glibc's and the system's headers (below)
#   use-gcc            show which one is in use
#
# Both are always there by version, too: gcc-4.1.2, g++-4.1.2, gcc-9.5.0,
# g++-9.5.0 (and cpp-, c++-), e.g. CC=gcc-9.5.0 ./configure.  C++ programs
# built by 9.5.0 need its libstdc++ at run time (use-gcc 9.5.0's DLL_PATH,
# or link with -static-libstdc++).
#
# Both compile against glibc's headers and start files
# (/system/resources/glibc/2.7) and the system headers.  4.1.2 finds those
# headers through C_INCLUDE_PATH; 9.5.0 searches them itself, after its own:
# its libstdc++ headers #include_next glibc's (<cstdlib>: <stdlib.h>), which
# fails when C_INCLUDE_PATH puts glibc's first.  gcc-9.5.0 and g++-9.5.0 drop
# them from C_INCLUDE_PATH themselves.

_gcc_sys_headers=/system/resources/glibc/2.7/include:/system/development/headers
_gcc_headers=/resources/index/framework/headers:/resources/index/include:/usr/local/include:/system/index/framework/headers
export C_INCLUDE_PATH=$_gcc_sys_headers:$_gcc_headers
export CPLUS_INCLUDE_PATH=$C_INCLUDE_PATH
_gcc_libs=/system/resources/glibc/2.7/lib:/resources/index/framework/libraries:/resources/index/lib:/usr/local/lib:/system/index/framework/libraries:/system/libraries
export LIBRARY_PATH=$_gcc_libs
export PKG_CONFIG_PATH=/resources/index/framework/PackageConfigure:/resources/index/lib/pkgconfig:/usr/local/lib/pkgconfig:/usr/local/share/pkgconfig:/system/index/framework/PackageConfigure
export ACLOCAL_PATH=/resources/index/share/aclocal

# _gcc_drop VALUE: VALUE (a :-list) without any /usr/gcc/<version>/... entries
_gcc_drop()
{
	echo ":$1:" | sed -e 's|:/usr/gcc/[^/:]*/[^:]*||g' -e 's|^:||' -e 's|:$||'
}

use_gcc()
{
	if [ -z "$1" ]
	then
		echo "GCC ${SYLLABLE_GCC:-(none)}: $(gcc --version 2>/dev/null | head -n 1)"
		return 0
	fi
	case $1 in
		4.1.2 | 9.5.0) ;;
		*) echo "usage: use-gcc 4.1.2|9.5.0" >&2; return 1 ;;
	esac
	if [ ! -x /usr/gcc/$1/bin/gcc ]
	then
		echo "use-gcc: GCC $1 isn't installed (/usr/gcc/$1)" >&2
		return 1
	fi
	PATH=/usr/gcc/$1/bin:$(_gcc_drop "$PATH")
	LIBRARY_PATH=/usr/gcc/$1/lib:$_gcc_libs
	DLL_PATH=$(_gcc_drop "$DLL_PATH")
	C_INCLUDE_PATH=$_gcc_sys_headers:$_gcc_headers
	if [ "$1" = 9.5.0 ]
	then
		# its programs need its libstdc++.so.6 (newer than the system's);
		# it searches glibc's and the system's headers itself
		DLL_PATH=/usr/gcc/$1/lib:$DLL_PATH
		C_INCLUDE_PATH=$_gcc_headers
	fi
	CPLUS_INCLUDE_PATH=$C_INCLUDE_PATH
	export PATH LIBRARY_PATH DLL_PATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH SYLLABLE_GCC=$1
}
# POSIX sh (bash as /bin/sh) rejects a hyphen in a function name and exits
# on it, so the function is use_gcc and use-gcc is an alias for shells
alias use-gcc=use_gcc

use_gcc 4.1.2 2>/dev/null


+/* The rest -----------------------------------------------------------------------*/
+
+void
+syllable_process_target::request_interrupt ()
+{
+  /* SIGINT to the main thread; wait stops the others.  */
+  thread_info *thr = get_first_thread ();
+  if (thr != nullptr)
+    ::kill (thr->id.pid (), SIGINT);
+}
+
+bool
+syllable_process_target::supports_hardware_single_step ()
+{
+  return true;
+}
+
+const gdb_byte *
+syllable_process_target::sw_breakpoint_from_kind (int kind, int *size)
+{
+  static const gdb_byte int3[] = { 0xcc };
+  *size = sizeof int3;
+  return int3;
+}
+
+bool
+syllable_process_target::supports_z_point_type (char z_type)
+{
+  return z_type == Z_PACKET_SW_BP;
+}
+
+int
+syllable_process_target::insert_point (enum raw_bkpt_type type, CORE_ADDR addr,
+				       int size, raw_breakpoint *bp)
+{
+  if (type == raw_bkpt_type_sw)
+    return insert_memory_breakpoint (bp);
+  return 1;				/* not supported */
+}
+
+int
+syllable_process_target::remove_point (enum raw_bkpt_type type, CORE_ADDR addr,
+				       int size, raw_breakpoint *bp)
+{
+  if (type == raw_bkpt_type_sw)
+    return remove_memory_breakpoint (bp);
+  return 1;
+}
+
+bool
+syllable_process_target::stopped_by_sw_breakpoint ()
+{
+  return current_thread != nullptr && syl (current_thread)->sw_bp;
+}
+
+bool
+syllable_process_target::supports_stopped_by_sw_breakpoint ()
+{
+  return true;
+}
+
+bool
+syllable_process_target::supports_non_stop ()
+{
+  return false;
+}
+
+bool
+syllable_process_target::supports_multi_process ()
+{
+  return true;
+}
+
+/* The i386 target: general registers, x87 and SSE (FXSAVE).  */
+
+static void
+syl_arch_setup ()
+{
+  target_desc_up tdesc
+    = i386_create_target_description (X86_XSTATE_SSE_MASK, false, false);
+  init_target_desc (tdesc.get (), i386_expedite_regs, GDB_OSABI_NONE);
+  current_process ()->tdesc = tdesc.release ();
+}
+
+static syllable_process_target the_syllable_target;
+
+void
+initialize_low ()
+{
+  set_target_ops (&the_syllable_target);
+}

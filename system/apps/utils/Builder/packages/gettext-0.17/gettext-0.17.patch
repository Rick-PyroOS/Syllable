glibc 2.7's <stdio.h> includes <wchar.h> with __need_mbstate_t; gnulib's wchar.h then set its
guard and skipped the full header later (mbstate_t undefined).  Pass those through, as later gnulib does.
--- a/gettext-runtime/gnulib-lib/wchar.in.h
+++ b/gettext-runtime/gnulib-lib/wchar.in.h
@@ -26,6 +26,12 @@
  * the declaration of wcwidth().
  */
 
+#if defined __need_mbstate_t || defined __need_wint_t
+/* Special invocation convention inside glibc header files (glibc 2.7's
+   <stdio.h> wants only mbstate_t): pass it to the system header, without
+   setting our guard.  */
+#include_next <wchar.h>
+#else
 #ifndef _GL_WCHAR_H
 
 /* Tru64 with Desktop Toolkit C has a bug: <stdio.h> must be included before
@@ -80,3 +86,4 @@
 
 #endif /* _GL_WCHAR_H */
 #endif /* _GL_WCHAR_H */
+#endif

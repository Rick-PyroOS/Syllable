diff -ruN gcc-9.5.0.original/libgcc/config/gthr-syllable.h gcc-9.5.0/libgcc/config/gthr-syllable.h
--- gcc-9.5.0.original/libgcc/config/gthr-syllable.h	1970-01-01 00:00:00.000000000 +0000
+++ gcc-9.5.0/libgcc/config/gthr-syllable.h	2026-10-09 13:10:32.920306149 +0000
@@ -0,0 +1,200 @@
+/* Threads compatibility routines for libgcc2 and libstdc++ on Syllable.
+   Copyright (C) 1997-2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+Under Section 7 of GPL version 3, you are granted additional
+permissions described in the GCC Runtime Library Exception, version
+3.1, as published by the Free Software Foundation.
+
+You should have received a copy of the GNU General Public License and
+a copy of the GCC Runtime Library Exception along with this program;
+see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_GTHR_SYLLABLE_H
+#define GCC_GTHR_SYLLABLE_H
+
+/* Native Syllable threads: kernel semaphores for blocking, kernel thread
+   local data (TLD) slots for keys.  Mutexes are "benaphores": an atomic
+   counter, with the semaphore only touched under contention.  */
+
+#define __GTHREADS 1
+
+#include <errno.h>
+#include <atheos/semaphore.h>
+#include <atheos/tld.h>
+#include <atheos/time.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef int __gthread_key_t;
+typedef struct { volatile int __state; } __gthread_once_t;
+typedef struct
+{
+  volatile int __count;
+  sem_id __sem;
+} __gthread_mutex_t;
+typedef __gthread_mutex_t __gthread_recursive_mutex_t;
+
+#define __GTHREAD_ONCE_INIT { 0 }
+#define __GTHREAD_MUTEX_INIT_FUNCTION __gthread_mutex_init_function
+#define __GTHREAD_RECURSIVE_MUTEX_INIT_FUNCTION \
+  __gthread_recursive_mutex_init_function
+
+static inline int
+__gthread_active_p (void)
+{
+  return 1;
+}
+
+static inline void
+__gthread_mutex_init_function (__gthread_mutex_t *__m)
+{
+  __m->__count = 0;
+  __m->__sem = create_semaphore ("gcc_mutex", 0, 0);
+}
+
+static inline void
+__gthread_recursive_mutex_init_function (__gthread_recursive_mutex_t *__m)
+{
+  /* Recursion is handled by the kernel semaphore, so a recursive mutex
+     always goes through it.  */
+  __m->__count = 0;
+  __m->__sem = create_semaphore ("gcc_rmutex", 1, SEM_RECURSIVE);
+}
+
+/* 0 = not run, 1 = running, 2 = done.  */
+static inline int
+__gthread_once (__gthread_once_t *__once, void (*__func) (void))
+{
+  if (__atomic_load_n (&__once->__state, __ATOMIC_ACQUIRE) == 2)
+    return 0;
+  int __expected = 0;
+  if (__atomic_compare_exchange_n (&__once->__state, &__expected, 1, 0,
+				   __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+    {
+      __func ();
+      __atomic_store_n (&__once->__state, 2, __ATOMIC_RELEASE);
+    }
+  else
+    while (__atomic_load_n (&__once->__state, __ATOMIC_ACQUIRE) != 2)
+      snooze (1000);
+  return 0;
+}
+
+static inline int
+__gthread_key_create (__gthread_key_t *__key, void (*__dtor) (void *))
+{
+  int __k = alloc_tld ((void *) __dtor);
+  if (__k < 0)
+    return EAGAIN;
+  *__key = __k;
+  return 0;
+}
+
+static inline int
+__gthread_key_delete (__gthread_key_t __key)
+{
+  return free_tld (__key) < 0 ? EINVAL : 0;
+}
+
+static inline void *
+__gthread_getspecific (__gthread_key_t __key)
+{
+  return get_tld (__key);
+}
+
+static inline int
+__gthread_setspecific (__gthread_key_t __key, const void *__ptr)
+{
+  set_tld (__key, __ptr);
+  return 0;
+}
+
+static inline int
+__gthread_mutex_destroy (__gthread_mutex_t *__m)
+{
+  delete_semaphore (__m->__sem);
+  return 0;
+}
+
+static inline int
+__gthread_mutex_lock (__gthread_mutex_t *__m)
+{
+  if (__atomic_fetch_add (&__m->__count, 1, __ATOMIC_ACQUIRE) > 0)
+    for (;;)
+      {
+	int __err = lock_semaphore (__m->__sem);
+	if (__err >= 0 || errno != EINTR)
+	  return __err < 0 ? __err : 0;
+      }
+  return 0;
+}
+
+static inline int
+__gthread_mutex_trylock (__gthread_mutex_t *__m)
+{
+  int __expected = 0;
+  if (__atomic_compare_exchange_n (&__m->__count, &__expected, 1, 0,
+				   __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+    return 0;
+  return EBUSY;
+}
+
+static inline int
+__gthread_mutex_unlock (__gthread_mutex_t *__m)
+{
+  if (__atomic_fetch_sub (&__m->__count, 1, __ATOMIC_RELEASE) > 1)
+    unlock_semaphore (__m->__sem);
+  return 0;
+}
+
+static inline int
+__gthread_recursive_mutex_lock (__gthread_recursive_mutex_t *__m)
+{
+  for (;;)
+    {
+      int __err = lock_semaphore (__m->__sem);
+      if (__err >= 0 || errno != EINTR)
+	return __err < 0 ? __err : 0;
+    }
+}
+
+static inline int
+__gthread_recursive_mutex_trylock (__gthread_recursive_mutex_t *__m)
+{
+  return lock_semaphore_x (__m->__sem, 1, 0, 0) < 0 ? EBUSY : 0;
+}
+
+static inline int
+__gthread_recursive_mutex_unlock (__gthread_recursive_mutex_t *__m)
+{
+  unlock_semaphore (__m->__sem);
+  return 0;
+}
+
+static inline int
+__gthread_recursive_mutex_destroy (__gthread_recursive_mutex_t *__m)
+{
+  delete_semaphore (__m->__sem);
+  return 0;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* GCC_GTHR_SYLLABLE_H */
diff -ruN gcc-9.5.0.original/libgcc/config/i386/t-syllable gcc-9.5.0/libgcc/config/i386/t-syllable

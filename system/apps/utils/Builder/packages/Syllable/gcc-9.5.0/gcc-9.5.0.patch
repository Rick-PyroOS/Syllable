diff -ruN gcc-9.5.0.original/gcc/config/i386/syllable.h gcc-9.5.0/gcc/config/i386/syllable.h
--- gcc-9.5.0.original/gcc/config/i386/syllable.h	1970-01-01 00:00:00.000000000 +0000
+++ gcc-9.5.0/gcc/config/i386/syllable.h	2026-10-09 16:30:40.106484632 +0000
@@ -0,0 +1,143 @@
+/* Definitions for Intel x86 running Syllable (ELF).
+   Copyright (C) 1998-2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* Syllable has no ld.so: the kernel loads every image itself, and every
+   image (executables included) is an ELF shared object linked at
+   0x80000000 (see binutils ld/emulparams/elf_i386_syllable.sh).  All code
+   is compiled as PIC by default.  */
+
+#define TARGET_OS_CPP_BUILTINS()			\
+  do							\
+    {							\
+      builtin_define_std ("unix");			\
+      builtin_define ("__ELF__");			\
+      builtin_define ("__ATHEOS__");			\
+      builtin_define ("__SYLLABLE__");			\
+      builtin_define ("__syllable__");			\
+      builtin_define ("__INTEL__");			\
+      builtin_define ("_X86_");				\
+      builtin_assert ("system=unix");			\
+      builtin_assert ("system=posix");			\
+      builtin_assert ("system=syllable");		\
+    }							\
+  while (0)
+
+/* The SVR4 ABI for the i386 says that records and unions are returned
+   in memory.  */
+#undef DEFAULT_PCC_STRUCT_RETURN
+#define DEFAULT_PCC_STRUCT_RETURN 1
+
+#undef ASM_COMMENT_START
+#define ASM_COMMENT_START "#"
+
+#undef DBX_REGISTER_NUMBER
+#define DBX_REGISTER_NUMBER(n) \
+  (TARGET_64BIT ? dbx64_register_map[n] : svr4_dbx_register_map[n])
+
+#undef SIZE_TYPE
+#define SIZE_TYPE "unsigned int"
+
+#undef PTRDIFF_TYPE
+#define PTRDIFF_TYPE "int"
+
+#undef WCHAR_TYPE
+#define WCHAR_TYPE "long int"
+
+#undef WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE BITS_PER_WORD
+
+/* Everything is PIC unless the user explicitly asks otherwise.  */
+#undef CC1_SPEC
+#define CC1_SPEC "%(cc1_cpu) %{profile:-p} \
+  %{!fno-pic:%{!fno-PIC:%{!fpie:%{!fPIE:%{!fpic:%{!fPIC:-fpic}}}}}}"
+
+/* The native compiler's system headers are glibc's
+   (--with-native-system-header-dir); the system's own follow them, as in
+   the cross compiler's sysroot, where glibc's win on the names both have.  */
+#ifndef CROSS_DIRECTORY_STRUCTURE
+#define SYLLABLE_SYSTEM_HEADERS " %{!nostdinc:%{!kernel:-idirafter /system/development/headers}}"
+#else
+#define SYLLABLE_SYSTEM_HEADERS ""
+#endif
+
+#undef CPP_SPEC
+#define CPP_SPEC "%{posix:-D_POSIX_SOURCE} -D_REENTRANT %{kernel:-D__KERNEL__}" \
+  SYLLABLE_SYSTEM_HEADERS
+
+/* The GNU C++ standard library requires _GNU_SOURCE.  */
+#undef CPLUSPLUS_CPP_SPEC
+#define CPLUSPLUS_CPP_SPEC "-D_GNU_SOURCE %(cpp)"
+
+/* crtbeginS/crtendS for everything, since every image is a shared object.
+   -kernel builds kernel drivers, which get no C runtime at all.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "%{!kernel: \
+     %{!shared: \
+       %{pg|p|profile:gcrt1.o%s;:crt1.o%s}} \
+     crti.o%s crtbeginS.o%s}"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "%{!kernel:crtendS.o%s crtn.o%s}"
+
+#undef LIB_SPEC
+#define LIB_SPEC \
+  "%{kernel:-lkernel} \
+   %{!kernel: \
+     %{shared:-lc} \
+     %{!shared:%{mieee-fp:-lieee} %{pthread:-lpthread} \
+       %{profile:-lc_p} %{!profile:-lc}}}"
+
+/* With -static or -static-libgcc the unwinder (SJLJ registration and
+   _Unwind_*) comes from libgcc_eh.a; the kernel needs neither.  */
+#undef LIBGCC_SPEC
+#define LIBGCC_SPEC \
+  "%{kernel:-lgcc;static|static-libgcc:-lgcc -lgcc_eh;:-lgcc_s -lgcc}"
+
+/* Executables are linked as shared objects too (%{!r:-shared}).
+   -plugin builds an add-on that may have undefined symbols resolved by
+   the application loading it.  */
+#undef LINK_SPEC
+#define LINK_SPEC \
+  "-m elf_i386_syllable \
+   %{!static:--eh-frame-hdr} \
+   %{shared:-shared} \
+   %{!shared:%{!static:%{rdynamic:-export-dynamic}} %{static:-static}} \
+   %{!r:-shared} \
+   %{!plugin:%{!shared:-Bsymbolic --no-undefined}} \
+   %{kernel:-shared}"
+
+/* Text relocations are not allowed, so keep EH tables writable.  */
+#undef EH_TABLES_CAN_BE_READ_ONLY
+#define EH_TABLES_CAN_BE_READ_ONLY 0
+
+#ifdef HAVE_GAS_MAX_SKIP_P2ALIGN
+#undef ASM_OUTPUT_MAX_SKIP_ALIGN
+#define ASM_OUTPUT_MAX_SKIP_ALIGN(FILE,LOG,MAX_SKIP)			\
+  do {									\
+    if ((LOG) != 0) {							\
+      if ((MAX_SKIP) == 0 || (MAX_SKIP) >= (1 << (LOG)) - 1)		\
+	fprintf ((FILE), "\t.p2align %d\n", (LOG));			\
+      else								\
+	fprintf ((FILE), "\t.p2align %d,,%d\n", (LOG), (MAX_SKIP));	\
+    }									\
+  } while (0)
+#endif
+
+#define TARGET_POSIX_IO

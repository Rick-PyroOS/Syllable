+++ gcc-9.5.0/libgcc/config/i386/t-syllable	2026-10-09 15:32:57.999777151 +0000
@@ -0,0 +1,8 @@
+# Syllable: libgcc and the crt objects are always PIC.
+CRTSTUFF_T_CFLAGS_S = $(CRTSTUFF_T_CFLAGS) -fPIC
+HOST_LIBGCC2_CFLAGS += -fPIC
+
+# Keep the soname of the GCC 4.1.2 built system (libgcc_s.so.3).  This libgcc_s
+# exports every symbol version the old one did (GCC_3.0 - GCC_4.0.0), so it
+# replaces it in place, and old and new code share one SJLJ unwind context chain.
+SHLIB_SOVERSION = 3
